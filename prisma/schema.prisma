// Prisma Schema for CareLink - AI-Powered Rural Healthcare Platform
// Supports Patient Journey, ASHA/ANM/CHO Workflows, Facility Management, Queue, E-Prescriptions, Lab Analysis & ML Auditing

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  PHARMACIST
  ASHA
  ANM
  CHO
  SUPER_ADMIN
}

enum HospitalType {
  SUB_CENTER
  PHC
  CHC
  DISTRICT_HOSPITAL
  PRIVATE_HOSPITAL
  GOVERNMENT_HOSPITAL
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentPriority {
  NORMAL
  HIGH
  EMERGENCY
}

enum QueueEventType {
  BOOKED
  CHECKED_IN
  PRIORITY_CHANGED
  STARTED
  COMPLETED
  CANCELLED
}

enum LabReportStatus {
  UPLOADED
  PROCESSING
  ANALYZED
  REVIEWED
}

enum ReferralStatus {
  CREATED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum WorkerType {
  ASHA
  ANM
  CHO
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  APPOINTMENT
  PRESCRIPTION
  LAB_REPORT
  REFERRAL
  EMERGENCY
  FOLLOW_UP
  SYSTEM
}

// ==========================================
// CORE AUTH & USERS
// ==========================================

model User {
  id           String    @id @default(cuid())
  name         String
  email        String?   @unique
  phone        String    @unique
  passwordHash String
  role         UserRole  @default(PATIENT)
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patientProfile        PatientProfile?
  doctorProfile         DoctorProfile?
  hospitalAdmin         HospitalAdmin?
  pharmacistProfile      PharmacistProfile?
  healthcareWorkerProfile HealthcareWorkerProfile?
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@index([email])
  @@index([phone])
  @@index([role])
}

model PatientProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime?
  gender            String?
  bloodGroup        String?
  address           String?
  village           String?
  district          String?
  state             String?
  emergencyContact  String?
  preferredLanguage String   @default("en")
  medicalHistory    Json?
  allergies         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  labReports         LabReport[]
  symptomAssessments SymptomAssessment[]
  referrals          Referral[]
  healthAssessments  HealthAssessment[]
  mlPredictions      MLPrediction[]
  followUps          FollowUp[]

  @@index([village, district])
}

model DoctorProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId         String?
  hospital           Hospital? @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  specialization     String
  qualification      String
  registrationNumber String    @unique
  experience         Int
  consultationFee    Float     @default(0.0)
  isAvailable        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  schedules      DoctorSchedule[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  referrals      Referral[]       @relation("DoctorReferrals")
  followUps      FollowUp[]

  @@index([specialization])
  @@index([hospitalId])
}

model Hospital {
  id                 String       @id @default(cuid())
  name               String
  registrationNumber String       @unique
  type               HospitalType
  address            String
  village            String?
  district           String
  state              String
  latitude           Float?
  longitude          Float?
  phone              String
  email              String?
  emergencyAvailable Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  doctors             DoctorProfile[]
  hospitalAdmins      HospitalAdmin[]
  appointments        Appointment[]
  medicalRecords      MedicalRecord[]
  labReports          LabReport[]
  pharmacies          Pharmacy[]
  outgoingReferrals   Referral[]      @relation("OutgoingReferrals")
  incomingReferrals   Referral[]      @relation("IncomingReferrals")
  assignedWorkers     HealthcareWorkerProfile[]
  followUps           FollowUp[]

  @@index([district, state])
  @@index([type])
  @@index([emergencyAvailable])
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model DoctorSchedule {
  id           String        @id @default(cuid())
  doctorId     String
  doctor       DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek    Int           // 0 (Sunday) to 6 (Saturday)
  startTime    String        // HH:mm (24hr)
  endTime      String        // HH:mm (24hr)
  slotDuration Int           @default(15) // Minutes per slot
  maxPatients  Int           @default(30)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([doctorId, dayOfWeek])
}

// ==========================================
// APPOINTMENTS & QUEUE MANAGEMENT
// ==========================================

model Appointment {
  id              String              @id @default(cuid())
  patientId       String
  patient         PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          DoctorProfile       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId      String
  hospital        Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointmentDate DateTime
  startTime       String              // HH:mm
  endTime         String              // HH:mm
  tokenNumber     Int?
  status          AppointmentStatus   @default(BOOKED)
  priority        AppointmentPriority @default(NORMAL)
  reason          String?
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  queueEvents     AppointmentEvent[]
  prescriptions   Prescription[]
  followUps       FollowUp[]

  @@unique([doctorId, appointmentDate, startTime])
  @@index([patientId])
  @@index([doctorId, appointmentDate])
  @@index([hospitalId, appointmentDate])
  @@index([status])
}

model AppointmentEvent {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventType     QueueEventType
  timestamp     DateTime       @default(now())
  actorId       String?
  metadata      Json?

  @@index([appointmentId])
}

// ==========================================
// CLINICAL RECORDS & DIAGNOSTICS
// ==========================================

model MedicalRecord {
  id          String         @id @default(cuid())
  patientId   String
  patient     PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId  String
  hospital    Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  recordType  String         // e.g. CONSULTATION, EMERGENCY, DISCHARGE
  diagnosis   String
  notes       String?
  treatment   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
}

model LabReport {
  id            String          @id @default(cuid())
  patientId     String
  patient       PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  hospitalId    String
  hospital      Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  uploadedBy    String
  fileUrl       String
  reportType    String          // e.g. BLOOD_CBC, ULTRASOUND, URINE
  extractedText String?         @db.Text
  reportDate    DateTime        @default(now())
  status        LabReportStatus @default(UPLOADED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  results LabResult[]

  @@index([patientId])
  @@index([hospitalId])
  @@index([status])
}

model LabResult {
  id             String    @id @default(cuid())
  labReportId    String
  labReport      LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)
  parameter      String    // e.g. Hemoglobin, WBC, Platelets
  value          String
  unit           String?
  referenceRange String?
  abnormalFlag   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([labReportId])
}

// ==========================================
// PHARMACY & PRESCRIPTIONS
// ==========================================

model Prescription {
  id            String         @id @default(cuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        DoctorProfile  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  instructions  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  medicines PrescriptionMedicine[]

  @@index([patientId])
  @@index([doctorId])
}

model Medicine {
  id           String   @id @default(cuid())
  name         String
  genericName  String
  manufacturer String
  category     String   // e.g. ANTIBIOTIC, ANALGESIC, ANTIHYPERTENSIVE
  strength     String   // e.g. 500mg, 10ml
  form         String   // e.g. TABLET, SYRUP, INJECTION
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prescribedIn PrescriptionMedicine[]
  inventories  PharmacyInventory[]

  @@index([name])
  @@index([genericName])
}

model PrescriptionMedicine {
  id             String       @id @default(cuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String
  medicine       Medicine     @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  dosage         String       // e.g. 1 tablet
  frequency      String       // e.g. Twice a day (1-0-1)
  duration       String       // e.g. 5 days
  instructions   String?

  @@index([prescriptionId])
  @@index([medicineId])
}

model Pharmacy {
  id         String   @id @default(cuid())
  hospitalId String   @unique
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  name       String
  address    String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pharmacists PharmacistProfile[]
  inventories PharmacyInventory[]
}

model PharmacistProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pharmacyId String
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PharmacyInventory {
  id          String   @id @default(cuid())
  pharmacyId  String
  pharmacy    Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  medicineId  String
  medicine    Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  quantity    Int
  batchNumber String
  expiryDate  DateTime
  price       Float    @default(0.0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([pharmacyId])
  @@index([medicineId])
  @@index([expiryDate])
}

// ==========================================
// REFERRALS
// ==========================================

model Referral {
  id             String              @id @default(cuid())
  patientId      String
  patient        PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fromHospitalId String
  fromHospital   Hospital            @relation("OutgoingReferrals", fields: [fromHospitalId], references: [id], onDelete: Cascade)
  toHospitalId   String
  toHospital     Hospital            @relation("IncomingReferrals", fields: [toHospitalId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         DoctorProfile?      @relation("DoctorReferrals", fields: [doctorId], references: [id], onDelete: SetNull)
  reason         String
  priority       AppointmentPriority @default(NORMAL)
  status         ReferralStatus      @default(CREATED)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([patientId])
  @@index([fromHospitalId])
  @@index([toHospitalId])
  @@index([status])
}

// ==========================================
// COMMUNITY HEALTHWORKERS (ASHA / ANM / CHO)
// ==========================================

model HealthcareWorkerProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerType         WorkerType
  village            String
  district           String
  state              String
  assignedFacilityId String?
  assignedFacility   Hospital? @relation(fields: [assignedFacilityId], references: [id], onDelete: SetNull)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assessments HealthAssessment[]

  @@index([village, district])
  @@index([workerType])
}

model HealthAssessment {
  id              String                  @id @default(cuid())
  patientId       String
  patient         PatientProfile          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workerId        String
  worker          HealthcareWorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  symptoms        Json
  vitals          Json?
  bloodPressure   String?
  heartRate       Int?
  temperature     Float?
  spo2            Float?
  bloodGlucose    Float?
  assessmentDate  DateTime                @default(now())
  riskLevel       RiskLevel               @default(LOW)
  mlPredictionId  String?
  createdAt       DateTime                @default(now())

  mlPredictions MLPrediction[]

  @@index([patientId])
  @@index([workerId])
  @@index([riskLevel])
}

model SymptomAssessment {
  id                     String         @id @default(cuid())
  patientId              String
  patient                PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptoms               Json
  duration               String
  severity               String
  additionalInformation String?
  createdAt              DateTime       @default(now())

  @@index([patientId])
}

// ==========================================
// ML & AI AUDITABLE PREDICTIONS
// ==========================================

model MLPrediction {
  id           String            @id @default(cuid())
  patientId    String
  patient      PatientProfile    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assessmentId String?
  assessment   HealthAssessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  modelName    String            // e.g. symptom-risk, triage, chronic-disease
  modelVersion String            // e.g. v1.0.0
  inputHash    String            // SHA256 of payload for audit verification
  prediction   Json
  probability  Float?
  riskLevel    RiskLevel?
  explanation  Json?
  createdAt    DateTime          @default(now()) // IMMUTABLE RECORD

  @@index([patientId])
  @@index([modelName])
  @@index([riskLevel])
}

// ==========================================
// NOTIFICATIONS, FOLLOW-UPS & AUDIT LOGS
// ==========================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model FollowUp {
  id            String         @id @default(cuid())
  patientId     String
  patient       PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  hospitalId    String?
  hospital      Hospital?      @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  followUpDate  DateTime
  reason        String
  status        String         @default("PENDING") // PENDING, COMPLETED, MISSED
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([patientId])
  @@index([followUpDate])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. PATIENT_REGISTER, ACCESS_LAB_REPORT, APPOINTMENT_BOOK
  entity    String   // e.g. PatientProfile, LabReport, Appointment
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now()) // IMMUTABLE

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
